---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Halftone from '../components/ui/Halftone.astro';
import Icon from '../components/ui/Icon.astro';
import NewsCard from '../components/sections/NewsCard.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { render } from 'astro:content';
import { path, formatDate, useT, type Lang } from '../i18n';
import { getNews, newsHref, newsAlternates, readingTime, type NewsEntry } from '../lib/news';
import type { PhotoKey } from '../data/images';
import { site } from '../data/site';
interface Props { lang: Lang; entry: NewsEntry }
const { lang, entry } = Astro.props;
const tr = useT(lang);
const { Content } = await render(entry);
const alternates = await newsAlternates(entry);
const more = (await getNews(lang)).filter((n) => n.id !== entry.id).slice(0, 3);
const url = new URL(newsHref(entry), Astro.site).href;
const ld = { '@context': 'https://schema.org', '@type': 'NewsArticle', headline: entry.data.title, description: entry.data.description, datePublished: entry.data.date.toISOString(), dateModified: entry.data.date.toISOString(), inLanguage: lang, author: { '@type': 'Organization', name: entry.data.author }, publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href } }, mainEntityOfPage: url };
const share = [
  { icon: 'linkedin-logo', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, label: 'LinkedIn' },
  { icon: 'x-logo', href: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(entry.data.title)}`, label: 'X' },
  { icon: 'envelope-simple', href: `mailto:?subject=${encodeURIComponent(entry.data.title)}&body=${encodeURIComponent(url)}`, label: 'Email' },
];
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates} type="article" headerTheme="light" jsonLd={[ld]}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="post">
    <header class="post__head container-narrow">
      <Breadcrumbs lang={lang} items={[{ label: tr('nav.news'), href: path('news', lang) }, { label: entry.data.category }]} />
      <p class="post__meta mono"><span class="post__cat">{entry.data.category}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time><span>{readingTime(entry)} {tr('news.minRead')}</span></p>
      <h1 class="h1 post__title" data-split>{entry.data.title}</h1>
      <p class="lead post__lead" data-reveal>{entry.data.description}</p>
    </header>
    <div class="container post__media" data-reveal="scale"><Halftone id={entry.data.photo as PhotoKey} lang={lang} tone="paper" ratio={21 / 9} reveal loading="eager" sizes="100vw" /></div>
    <div class="container-narrow post__body">
      <aside class="post__share" aria-label="Share">
        {share.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a>)}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <section class="section surface-alt">
    <div class="container">
      <p class="mono more__h">{tr('news.latest')}</p>
      <div class="grid">{more.map((n) => <NewsCard href={newsHref(n)} title={n.data.title} excerpt={n.data.description} date={n.data.date} category={n.data.category} photo={n.data.photo as PhotoKey} lang={lang} />)}</div>
    </div>
  </section>
  <CtaBand lang={lang} />
</BaseLayout>
<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60; }
  .progress span { display: block; height: 100%; background: var(--grad-sun); transform-origin: left; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) { .progress span { animation: grow linear both; animation-timeline: scroll(root); } @keyframes grow { to { transform: scaleX(1); } } }
  .post__head { padding-top: calc(76px + var(--space-8)); display: grid; gap: var(--space-5); }
  .post__meta { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-muted); }
  .post__cat { padding: 0.25em 0.6em; border-radius: 4px; background: var(--c-sun); color: var(--c-ink); }
  .post__media { margin-block: var(--space-7); border-radius: var(--radius-lg); overflow: hidden; }
  .post__body { position: relative; padding-bottom: var(--section-y); }
  .post__share { display: flex; gap: 0.5rem; margin-bottom: var(--space-6); }
  @media (min-width: 1200px) { .post__share { position: absolute; left: -5rem; top: 0; flex-direction: column; } }
  .post__share a { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; border: 1px solid var(--c-line); transition: background var(--dur-fast); }
  .post__share a:hover { background: var(--c-sun); border-color: var(--c-sun); }
  .more__h { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--c-muted); margin-bottom: var(--space-6); }
  .grid { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
