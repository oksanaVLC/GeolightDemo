---
/** Páginas legales (plantilla). ⚠️ Texto orientativo: revísalo con tu asesor legal antes de publicar. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { useT, type Lang, type RouteKey } from '../i18n';
import { site } from '../data/site';
interface Props { lang: Lang; kind: 'privacy' | 'cookies' | 'legal' }
const { lang, kind } = Astro.props;
const tr = useT(lang);
const titles = { privacy: tr('footer.privacy'), cookies: tr('footer.cookies'), legal: tr('footer.legal') };
const addr = `${site.address.street}, ${site.address.postalCode} ${site.address.city}`;
const body = {
  es: {
    legal: [`<h2>Titular del sitio</h2><p>${site.legalName} · ${addr} · ${site.email}.</p>`, `<h2>Propiedad intelectual</h2><p>Los contenidos, marcas y diseño de este sitio pertenecen a ${site.legalName}. Las fotografías proceden de <a href="https://unsplash.com" rel="noopener">Unsplash</a> bajo su licencia libre y los iconos de <a href="https://phosphoricons.com" rel="noopener">Phosphor Icons</a> (MIT).</p>`, '<h2>Responsabilidad</h2><p>La información de esta web tiene carácter orientativo y puede cambiar sin previo aviso.</p>'],
    privacy: [`<h2>Responsable del tratamiento</h2><p>${site.legalName}, ${addr}. Contacto: ${site.email}.</p>`, '<h2>Finalidad</h2><p>Atender las consultas enviadas por formulario y, si lo solicitas, enviarte nuestro boletín.</p>', '<h2>Base legal</h2><p>Tu consentimiento (art. 6.1.a RGPD) y el interés legítimo en responder solicitudes.</p>', '<h2>Derechos</h2><p>Puedes ejercer los derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a nuestro email.</p>'],
    cookies: ['<h2>Cookies utilizadas</h2><p>Este sitio no utiliza cookies de analítica ni publicidad. Solo se usan elementos técnicos imprescindibles para su funcionamiento.</p>', '<p>Si en el futuro se añade analítica, se incorporará un banner de consentimiento conforme a la guía de la AEPD.</p>'],
  },
  en: {
    legal: [`<h2>Site owner</h2><p>${site.legalName} · ${addr} · ${site.email}.</p>`, `<h2>Intellectual property</h2><p>Content, trademarks and design belong to ${site.legalName}. Photographs are from <a href="https://unsplash.com" rel="noopener">Unsplash</a> under its free licence and icons from <a href="https://phosphoricons.com" rel="noopener">Phosphor Icons</a> (MIT).</p>`, '<h2>Liability</h2><p>Information on this site is indicative and may change without notice.</p>'],
    privacy: [`<h2>Data controller</h2><p>${site.legalName}, ${addr}. Contact: ${site.email}.</p>`, '<h2>Purpose</h2><p>To answer enquiries sent through our forms and, if requested, to send you our newsletter.</p>', '<h2>Legal basis</h2><p>Your consent (Art. 6.1.a GDPR) and our legitimate interest in answering requests.</p>', '<h2>Your rights</h2><p>You may exercise your rights of access, rectification, erasure, objection, restriction and portability by emailing us.</p>'],
    cookies: ['<h2>Cookies used</h2><p>This site does not use analytics or advertising cookies. Only strictly necessary technical elements are used.</p>', '<p>If analytics are added in the future, a consent banner will be added in line with applicable guidance.</p>'],
  },
}[lang][kind];
const routeKey: RouteKey = kind;
---
<BaseLayout lang={lang} title={titles[kind]} description={`${titles[kind]} — ${site.name}`} routeKey={routeKey}>
  <PageHero lang={lang} title={titles[kind]} crumbs={[{ label: titles[kind] }]} />
  <section class="section"><div class="container-narrow prose" set:html={body.join('')} /></section>
</BaseLayout>
