---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import ProjectCard from '../components/sections/ProjectCard.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { path, detailPath, t, useT, type Lang } from '../i18n';
import { solutions, type Solution } from '../data/solutions';
import { projects } from '../data/projects';
interface Props { lang: Lang; solution: Solution }
const { lang, solution: s } = Astro.props;
const tr = useT(lang);
const related = projects.filter((p) => p.type === s.key).slice(0, 3);
const others = solutions.filter((x) => x.key !== s.key);
const faqItems = s.faqs.map((f) => ({ q: t(f.q, lang), a: t(f.a, lang) }));
const alternates = { es: detailPath('solutions', s.slug.es, 'es'), en: detailPath('solutions', s.slug.en, 'en') };
const c = {
  es: { caps: 'Qué incluye', capsT: 'Todo lo necesario, bajo un mismo contrato.', specs: 'Ficha técnica', faq: 'Preguntas frecuentes', proj: 'Proyectos de referencia', other: 'Otras soluciones', talk: 'Hablar con un especialista' },
  en: { caps: 'What is included', capsT: 'Everything you need, under one contract.', specs: 'Technical sheet', faq: 'FAQ', proj: 'Reference projects', other: 'Other solutions', talk: 'Talk to a specialist' },
}[lang];
const serviceLd = { '@context': 'https://schema.org', '@type': 'Service', name: t(s.title, lang), description: t(s.intro, lang), provider: { '@type': 'Organization', name: 'GEOLight' }, areaServed: ['ES', 'PT', 'IT'] };
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout lang={lang} title={t(s.title, lang)} description={t(s.short, lang)} alternates={alternates} jsonLd={[serviceLd, faqLd]}>
  <PageHero lang={lang} title={t(s.title, lang)} lead={t(s.intro, lang)} eyebrow={tr('nav.solutions')} code={s.code} photo={s.photo} crumbs={[{ label: tr('nav.solutions'), href: path('solutions', lang) }, { label: t(s.title, lang) }]}>
    <div class="sd__hero-cta" data-reveal style="--delay:300ms">
      <Button href={path('contact', lang)} size="lg">{c.talk}</Button>
      <span class="sd__metric"><strong>{s.metric.value}</strong> <span class="mono">{t(s.metric.label, lang)}</span></span>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow={c.caps} index="01" title={c.capsT} align="split" />
      <ul class="caps" role="list" data-stagger="70">
        {s.capabilities.map((cap, i) => (
          <li class="cap" data-reveal>
            <div class="cap__top"><Icon name={cap.icon} size={30} /><span class="mono">{String(i + 1).padStart(2, '0')}</span></div>
            <h3 class="h4">{t(cap.title, lang)}</h3>
            <p class="muted">{t(cap.text, lang)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-alt">
    <div class="container specs-wrap">
      <SectionHeader eyebrow={c.specs} index="02" title={t(s.title, lang)} size="h3" />
      <dl class="specs">
        {s.specs.map((sp) => (
          <div class="spec" data-reveal>
            <dt class="mono">{t(sp.label, lang)}</dt>
            <dd>{t(sp.value, lang)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section surface-alt">
      <div class="container">
        <SectionHeader eyebrow={c.proj} index="03" title={c.proj} align="split">
          <Button href={path('projects', lang)} variant="ghost">{tr('cta.viewAll')}</Button>
        </SectionHeader>
        <div class="grid3" data-stagger="90">{related.map((p) => <div data-reveal><ProjectCard project={p} lang={lang} /></div>)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container faq">
      <SectionHeader eyebrow={c.faq} index="04" title={c.faq} />
      <Accordion items={faqItems} />
    </div>
  </section>

  <section class="section--tight surface-white">
    <div class="container">
      <p class="mono others__h">{c.other}</p>
      <ul class="others" role="list">
        {others.map((o) => (
          <li><a href={detailPath('solutions', o.slug[lang], lang)}><Icon name={o.icon} size={24} /><span>{t(o.title, lang)}</span><Icon name="arrow-up-right" size={18} /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
<style>
  .sd__hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); margin-top: var(--space-3); }
  .sd__metric strong { font-size: var(--fs-xl); font-weight: 500; letter-spacing: -0.04em; color: var(--c-sun); }
  .sd__metric .mono { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted-dark); }
  .caps { display: grid; gap: var(--space-4); }
  @media (min-width: 700px) { .caps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .caps { grid-template-columns: repeat(3, 1fr); } }
  .cap { display: grid; gap: var(--space-3); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--c-line); background: var(--c-white); align-content: start; transition: border-color var(--dur), transform var(--dur) var(--ease-out); }
  .cap:hover { border-color: var(--c-sun); transform: translateY(-3px); }
  .cap__top { display: flex; justify-content: space-between; align-items: start; color: var(--c-ember); margin-bottom: var(--space-4); }
  .cap__top .mono { font-size: var(--fs-xs); color: var(--c-muted); }
  .specs-wrap { display: grid; gap: var(--space-6); }
  @media (min-width: 1000px) { .specs-wrap { grid-template-columns: 0.8fr 1.2fr; align-items: start; } }
  .specs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--c-line); border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
  .spec { background: var(--c-white); padding: var(--space-6) var(--space-5); display: grid; gap: var(--space-3); }
  .spec dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); }
  .spec dd { font-size: var(--fs-xl); letter-spacing: -0.035em; color: var(--c-sun); }
  .grid3 { display: grid; gap: var(--space-5); }
  @media (min-width: 800px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
  .faq { display: grid; gap: var(--space-6); }
  @media (min-width: 1000px) { .faq { grid-template-columns: 0.8fr 1.2fr; } }
  .others__h { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--c-muted); margin-bottom: var(--space-4); }
  .others { display: grid; gap: var(--space-3); }
  @media (min-width: 800px) { .others { grid-template-columns: repeat(3, 1fr); } }
  .others a { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-4); align-items: center; padding: var(--space-5); border: 1px solid var(--c-line); border-radius: var(--radius); font-weight: 500; transition: background var(--dur-fast), color var(--dur-fast); }
  .others a:hover { background: var(--c-ink); color: var(--c-paper); }
  @media (max-width: 560px) { .specs { grid-template-columns: 1fr; } }
</style>
