---
/** Proceso en 5 pasos: título fijo (sticky) a la izquierda + pasos con línea de progreso ligada al scroll. */
import Icon from '../ui/Icon.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { process } from '../../data/company';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang; index?: string }
const { lang, index = '03' } = Astro.props;
const copy = {
  es: { eyebrow: 'Cómo trabajamos', title: 'Un solo equipo, del terreno a la red.', text: 'Integramos las cinco fases del ciclo de vida de un activo renovable. Menos interfaces, menos riesgo y un único responsable durante 30 años.' },
  en: { eyebrow: 'How we work', title: 'One team, from land to grid.', text: 'We integrate the five stages of a renewable asset’s life. Fewer interfaces, less risk and one accountable partner for 30 years.' },
}[lang];
---
<div class="ps" data-process>
  <div class="ps__aside">
    <div class="ps__sticky">
      <Eyebrow index={index}>{copy.eyebrow}</Eyebrow>
      <h2 class="h2" data-split>{copy.title}</h2>
      <p class="lead">{copy.text}</p>
      <div class="ps__meter mono" aria-hidden="true"><span data-process-num>01</span> / 05</div>
    </div>
  </div>
  <ol class="ps__steps" role="list">
    <span class="ps__line" aria-hidden="true"><span class="ps__fill" data-process-fill></span></span>
    {process.map((s, i) => (
      <li class="ps__step" data-step={i}>
        <span class="ps__dot" aria-hidden="true"></span>
        <div class="ps__card">
          <div class="ps__head"><span class="ps__code mono">{s.code}</span><Icon name={s.icon} size={30} /></div>
          <h3 class="h3">{t(s.title, lang)}</h3>
          <p class="muted">{t(s.text, lang)}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
<style>
  .ps { display: grid; gap: var(--space-7); }
  @media (min-width: 1000px) { .ps { grid-template-columns: 1fr 1.1fr; gap: var(--space-9); } .ps__sticky { position: sticky; top: 130px; } }
  .ps__sticky { display: grid; gap: var(--space-5); justify-items: start; }
  .ps__meter { font-size: var(--fs-2xl); color: var(--c-ink); letter-spacing: -0.04em; }
  .ps__meter span { color: var(--c-ember); }
  .ps__steps { position: relative; display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); padding-left: 2.6rem; }
  .ps__line { position: absolute; left: 0.55rem; top: 0.6rem; bottom: 0.6rem; width: 2px; background: var(--c-line); border-radius: 2px; overflow: hidden; }
  .ps__fill { position: absolute; inset: 0; background: var(--grad-sun); transform-origin: top; transform: scaleY(var(--p, 0)); }
  .ps__step { position: relative; }
  .ps__dot { position: absolute; left: -2.6rem; top: 1.6rem; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: var(--c-paper); border: 2px solid var(--c-line); transition: background var(--dur), border-color var(--dur), transform var(--dur) var(--ease-out); }
  .ps__step.is-active .ps__dot { background: var(--c-sun); border-color: var(--c-sun); transform: scale(1.25); }
  .ps__card { display: grid; gap: 0.8rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--radius-lg); background: var(--c-white); border: 1px solid var(--c-line); transition: box-shadow var(--dur), transform var(--dur) var(--ease-out); }
  .ps__step.is-active .ps__card { box-shadow: var(--shadow); transform: translateX(6px); }
  .ps__head { display: flex; justify-content: space-between; align-items: center; color: var(--c-ember); }
  .ps__code { font-size: var(--fs-sm); color: var(--c-muted); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-process]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const fill = root.querySelector<HTMLElement>('[data-process-fill]');
    const num = root.querySelector<HTMLElement>('[data-process-num]');
    const list = root.querySelector<HTMLElement>('.ps__steps')!;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const mid = window.innerHeight * 0.55;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      fill?.style.setProperty('--p', p.toFixed(3));
      let active = 0;
      steps.forEach((s, i) => { if (s.getBoundingClientRect().top < mid) active = i; });
      steps.forEach((s, i) => s.classList.toggle('is-active', i === active));
      if (num) num.textContent = String(active + 1).padStart(2, '0');
    };
    update();
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  });
</script>
