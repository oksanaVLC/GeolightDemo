---
/**
 * Mapa de puntos (dot-matrix) de Europa occidental generado a partir de Natural Earth
 * (world-atlas) en /src/data/dotmap.json. Península ibérica resaltada, pines animados
 * por proyecto y lista sincronizada (hover en lista ↔ pin).
 */
import map from '../../data/dotmap.json';
import { projects, typeLabel } from '../../data/projects';
import { detailPath, t, type Lang } from '../../i18n';
import Icon from '../ui/Icon.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { width, height, bounds, k, scale, dots } = map as {
  width: number;
  height: number;
  bounds: {
    lonMin: number;
    lonMax: number;
    latMin: number;
    latMax: number;
  };
  k: number;
  scale: number;
  dots: [number, number, number][];
};
const project = (lon: number, lat: number) => ({
  x: (lon - bounds.lonMin) * k * scale,
  y: (bounds.latMax - lat) * scale,
});
const pins = projects.map((p, i) => ({ ...p, ...project(p.lon, p.lat), i }));
---

<div class="pm">
  <div class="pm__map" data-reveal="fade">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={lang === 'es' ? 'Mapa de proyectos de GEOLight' : 'Map of GEOLight projects'}
    >
      <g class="pm__dots">
        {dots.map(([x, y, hl]) => (
          <circle cx={x} cy={y} r={hl ? 2.7 : 2.1} class={hl ? 'hl' : undefined} />
        ))}
      </g>
      <g class="pm__pins">
        {pins.map((p) => (
          <a href={detailPath('projects', p.slug[lang], lang)} class="pm__pin" data-pin={p.i} aria-label={p.name}>
            <circle cx={p.x} cy={p.y} r="20" class="pm__pulse" style={`animation-delay:${p.i * 0.35}s`} />
            <circle cx={p.x} cy={p.y} r="7.5" class="pm__core" />
          </a>
        ))}
      </g>
    </svg>
    <div class="pm__legend mono">
      <span>
        <i class="lg lg--hl"></i>Iberia
      </span>
      <span>
        <i class="lg lg--pin"></i>
        {lang === 'es' ? 'Proyecto GEOLight' : 'GEOLight project'}
      </span>
    </div>
  </div>
  <ol class="pm__list" role="list" data-stagger="60">
    {pins.map((p) => (
      <li data-reveal>
        <a href={detailPath('projects', p.slug[lang], lang)} class="pm__row" data-row={p.i}>
          <span class="pm__n mono">{String(p.i + 1).padStart(2, '0')}</span>
          <span class="pm__name">
            {p.name}
            <small>
              {t(p.location, lang)} · {t(typeLabel[p.type], lang)}
            </small>
          </span>
          <span class="pm__cap mono">{p.capacity}</span>
          <Icon name="arrow-up-right" size={16} class="pm__arrow" />
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .pm {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .pm {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .pm__map {
    position: relative;
  }
  .pm__map svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pm__dots circle {
    fill: rgb(17 26 74 / 0.14);
  }
  .pm__dots circle.hl {
    fill: rgb(22 126 108 / 0.55);
  }
  .pm__core {
    fill: var(--c-sun);
    stroke: var(--c-white);
    stroke-width: 3;
    transition: r var(--dur) var(--ease-out);
  }
  .pm__pulse {
    fill: var(--c-sun);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: pin 2.8s var(--ease-out) infinite;
  }
  .pm__pin:hover .pm__core,
  .pm__pin.is-active .pm__core {
    r: 12;
    fill: var(--c-ink);
    stroke: var(--c-sun);
  }
  @keyframes pin {
    0% {
      opacity: 0.55;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  .pm__legend {
    display: flex;
    gap: 1.2rem;
    margin-top: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .pm__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lg {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .lg--hl {
    background: rgb(22 126 108 / 0.55);
  }
  .lg--pin {
    background: var(--c-sun);
  }
  .pm__list {
    border-top: 1px solid var(--c-line);
  }
  .pm__row {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto 1rem;
    gap: 0.8rem;
    align-items: center;
    padding: 0.95rem 0.4rem;
    border-bottom: 1px solid var(--c-line);
    transition:
      background var(--dur-fast),
      padding var(--dur) var(--ease-out);
  }
  .pm__row:hover,
  .pm__row.is-active {
    background: var(--c-white);
    padding-left: 0.9rem;
  }
  .pm__n {
    font-size: 0.7rem;
    color: var(--c-sun);
  }
  .pm__name {
    display: grid;
    font-weight: 500;
  }
  .pm__name small {
    font-weight: 400;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .pm__cap {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  :global(.pm__arrow) {
    opacity: 0.4;
    transition:
      opacity var(--dur-fast),
      transform var(--dur-fast);
  }
  .pm__row:hover :global(.pm__arrow) {
    opacity: 1;
    transform: translate(2px, -2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .pm__pulse {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.pm').forEach((root) => {
    const set = (i: string | undefined, on: boolean) => {
      if (i === undefined) return;
      root.querySelector(`[data-pin="${i}"]`)?.classList.toggle('is-active', on);
      root.querySelector(`[data-row="${i}"]`)?.classList.toggle('is-active', on);
    };
    root.querySelectorAll<HTMLElement>('[data-pin], [data-row]').forEach((el) => {
      const i = el.dataset.pin ?? el.dataset.row;
      el.addEventListener('mouseenter', () => set(i, true));
      el.addEventListener('mouseleave', () => set(i, false));
      el.addEventListener('focus', () => set(i, true));
      el.addEventListener('blur', () => set(i, false));
    });
  });
</script>
