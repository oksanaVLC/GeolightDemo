---
/**
 * Calculadora de autoconsumo (orientativa). Parámetros editables en `params`.
 * Resultado: potencia recomendada, ahorro anual, retorno y CO₂ evitado.
 */
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { path, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const params = { price: 0.145, yieldKwhKwp: 1650, costPerKwp: 720, co2PerKwh: 0.00019, maxCoverage: 0.65 };
const c = {
  es: { eyebrow: 'Calculadora', title: '¿Cuánto ahorraría tu empresa?', bill: 'Factura eléctrica mensual', day: 'Consumo en horas de sol', roof: 'Superficie disponible', kwp: 'Potencia recomendada', save: 'Ahorro anual estimado', payback: 'Retorno de la inversión', co2: 'CO₂ evitado al año', years: 'años', note: 'Estimación orientativa con precio medio de 0,145 €/kWh y producción de 1.650 kWh/kWp en el Mediterráneo. Hacemos el estudio real gratis con tus datos cuartohorarios.', cta: 'Pedir estudio gratuito', t: 't' },
  en: { eyebrow: 'Calculator', title: 'How much could your company save?', bill: 'Monthly electricity bill', day: 'Consumption during daylight', roof: 'Available surface', kwp: 'Recommended capacity', save: 'Estimated annual savings', payback: 'Payback period', co2: 'CO₂ avoided per year', years: 'years', note: 'Indicative estimate using an average price of €0.145/kWh and a Mediterranean yield of 1,650 kWh/kWp. We run the real study for free using your 15-minute data.', cta: 'Request a free study', t: 't' },
}[lang];
---
<div class="calc" data-calc data-params={JSON.stringify(params)} data-locale={lang === 'es' ? 'es-ES' : 'en-GB'}>
  <div class="calc__form">
    <Eyebrow>{c.eyebrow}</Eyebrow>
    <h2 class="h3">{c.title}</h2>
    <label class="calc__field">
      <span class="calc__label">{c.bill}<output class="mono" data-out="bill">15.000 €</output></span>
      <input type="range" min="2000" max="150000" step="1000" value="15000" name="bill" />
    </label>
    <label class="calc__field">
      <span class="calc__label">{c.day}<output class="mono" data-out="day">60 %</output></span>
      <input type="range" min="20" max="90" step="5" value="60" name="day" />
    </label>
    <label class="calc__field">
      <span class="calc__label">{c.roof}<output class="mono" data-out="roof">8.000 m²</output></span>
      <input type="range" min="500" max="60000" step="500" value="8000" name="roof" />
    </label>
    <p class="calc__note">{c.note}</p>
  </div>
  <div class="calc__result surface-dark">
    <div class="calc__big">
      <span class="calc__rl mono">{c.save}</span>
      <span class="calc__rv" data-res="save">—</span>
    </div>
    <dl class="calc__grid">
      <div><dt class="mono">{c.kwp}</dt><dd data-res="kwp">—</dd></div>
      <div><dt class="mono">{c.payback}</dt><dd><span data-res="payback">—</span> {c.years}</dd></div>
      <div><dt class="mono">{c.co2}</dt><dd><span data-res="co2">—</span> {c.t}</dd></div>
    </dl>
    <div class="calc__bar" aria-hidden="true"><span data-res-bar></span></div>
    <Button href={path('contact', lang)} variant="primary">{c.cta}</Button>
  </div>
</div>
<style>
  .calc { display: grid; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--c-line); background: var(--c-white); }
  @media (min-width: 900px) { .calc { grid-template-columns: 1.1fr 1fr; } }
  .calc__form { display: grid; gap: var(--space-5); padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); align-content: start; }
  .calc__field { display: grid; gap: 0.7rem; }
  .calc__label { display: flex; justify-content: space-between; font-weight: 500; font-size: var(--fs-sm); }
  .calc__label output { color: var(--c-ember); }
  input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 6px; background: linear-gradient(90deg, var(--c-sun) var(--fill, 50%), var(--c-paper-2) var(--fill, 50%)); outline-offset: 6px; }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--c-ink); border: 4px solid var(--c-sun); cursor: grab; }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--c-ink); border: 4px solid var(--c-sun); cursor: grab; }
  .calc__note { font-size: var(--fs-xs); color: var(--c-muted); }
  .calc__result { display: grid; gap: var(--space-5); padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); align-content: center; position: relative; background-image: radial-gradient(circle, rgb(255 178 31 / 0.18) 1px, transparent 1.5px); background-size: 16px 16px; }
  .calc__big { display: grid; gap: 0.3rem; }
  .calc__rl, dt { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted-dark); }
  .calc__rv { font-size: var(--fs-3xl); letter-spacing: -0.05em; line-height: 1; color: var(--c-sun); font-variant-numeric: tabular-nums; }
  .calc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); border-top: 1px solid var(--c-line-dark); padding-top: var(--space-5); }
  dd { font-size: var(--fs-lg); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .calc__bar { height: 8px; border-radius: 8px; background: var(--c-ink-3); overflow: hidden; }
  .calc__bar span { display: block; height: 100%; width: 40%; background: var(--grad-sun); transition: width var(--dur) var(--ease-out); }
  @media (max-width: 560px) { .calc__grid { grid-template-columns: 1fr; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const P = JSON.parse(root.dataset.params!);
    const loc = root.dataset.locale;
    const nf = (n: number, d = 0) => new Intl.NumberFormat(loc, { maximumFractionDigits: d, minimumFractionDigits: d }).format(n);
    const inputs = root.querySelectorAll<HTMLInputElement>('input[type=range]');
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const calc = () => {
      const v: Record<string, number> = {};
      inputs.forEach((i) => { v[i.name] = Number(i.value); i.style.setProperty('--fill', `${((+i.value - +i.min) / (+i.max - +i.min)) * 100}%`); });
      q('[data-out=bill]').textContent = `${nf(v.bill)} €`;
      q('[data-out=day]').textContent = `${v.day} %`;
      q('[data-out=roof]').textContent = `${nf(v.roof)} m²`;
      const annualKwh = (v.bill * 12) / P.price;
      const coverage = Math.min(v.day / 100, P.maxCoverage);
      const kwpByLoad = (annualKwh * coverage) / P.yieldKwhKwp;
      const kwpByRoof = v.roof / 5.2; // ~5,2 m² por kWp en cubierta
      const kwp = Math.min(kwpByLoad, kwpByRoof);
      const kwh = kwp * P.yieldKwhKwp;
      const save = kwh * P.price;
      const payback = (kwp * P.costPerKwp) / save;
      q('[data-res=save]').textContent = `${nf(save)} €`;
      q('[data-res=kwp]').textContent = kwp >= 1000 ? `${nf(kwp / 1000, 2)} MWp` : `${nf(kwp)} kWp`;
      q('[data-res=payback]').textContent = nf(payback, 1);
      q('[data-res=co2]').textContent = nf(kwh * P.co2PerKwh, 0);
      q('[data-res-bar]').style.width = `${Math.min(100, (save / (v.bill * 12)) * 100 * 1.6)}%`;
    };
    inputs.forEach((i) => i.addEventListener('input', calc));
    calc();
  });
</script>
