---
/**
 * <head> SEO: title, description, canonical, hreflang (es/en/x-default), Open Graph, Twitter
 * y datos estructurados JSON-LD (Organization + WebSite siempre; extras por página).
 */
import { htmlLang, ogLocale, type Lang } from '../../i18n';
import { site } from '../../data/site';
interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
}
const { lang, title, description, alternates, image = '/og-default.png', type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${base.origin}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: base.origin,
  logo: new URL('/favicon.svg', base).href,
  foundingDate: String(site.founded),
  email: site.email,
  telephone: site.phone,
  description: site.description[lang],
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.postalCode, addressLocality: site.address.city, addressRegion: site.address.region, addressCountry: site.address.country },
  areaServed: ['ES', 'PT', 'IT'],
  sameAs: Object.values(site.social),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${base.origin}/#website`, url: base.origin, name: site.name, inLanguage: ['es-ES', 'en-GB'], publisher: { '@id': `${base.origin}/#organization` } };
const graph = [org, website, ...jsonLd];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{Object.entries(alternates).map(([l, href]) => href && <link rel="alternate" hreflang={htmlLang[l as Lang]} href={new URL(href, base).href} />)}
{alternates.es && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, base).href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale[lang]} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
