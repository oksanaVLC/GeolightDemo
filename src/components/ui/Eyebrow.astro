---
/** Etiqueta superior tipo "[ 01 — SOLUCIONES ]" en monoespaciada. */
interface Props { index?: string; class?: string; tone?: 'default' | 'sun' }
const { index, class: className = '', tone = 'default' } = Astro.props;
---
<p class:list={['eyebrow', `eyebrow--${tone}`, className]}>
  <span class="eyebrow__br" aria-hidden="true">[</span>
  {index && <span class="eyebrow__i">{index}</span>}
  {index && <span class="eyebrow__dash" aria-hidden="true">—</span>}
  <span><slot /></span>
  <span class="eyebrow__br" aria-hidden="true">]</span>
</p>
<style>
  .eyebrow { display: inline-flex; align-items: center; gap: 0.6em; font-family: var(--font-mono); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--c-muted); }
  :global(.surface-dark) .eyebrow, :global(.on-dark) .eyebrow { color: var(--c-muted-dark); }
  .eyebrow__br { color: var(--c-sun); font-weight: 600; }
  .eyebrow__i { color: currentColor; opacity: 0.7; }
  .eyebrow--sun { color: var(--c-sun); }
</style>
