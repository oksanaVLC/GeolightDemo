---
/**
 * Foto responsive desde el CDN de Unsplash con srcset automático.
 *   <Photo id="aerialPlant" lang={lang} ratio={4/3} sizes="(min-width: 900px) 50vw, 100vw" />
 * Si la imagen no carga, el contenedor muestra un degradado de marca (nunca un hueco).
 */
import { photos, unsplashUrl, type PhotoKey } from '../../data/images';
import type { Lang } from '../../i18n';
interface Props {
  id: PhotoKey;
  lang: Lang;
  ratio?: number;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  alt?: string;
}
const { id, lang, ratio = 4 / 3, sizes = '100vw', widths = [480, 768, 1080, 1440, 2000], loading = 'lazy', fetchpriority = 'auto', class: className = '', alt } = Astro.props;
const p = photos[id];
const h = (w: number) => Math.round(w / ratio);
const srcset = widths.map((w) => `${unsplashUrl(p.src, w, h(w))} ${w}w`).join(', ');
const base = widths[Math.min(2, widths.length - 1)];
---
<img
  class:list={['photo', className]}
  src={unsplashUrl(p.src, base, h(base))}
  srcset={srcset}
  sizes={sizes}
  width={base}
  height={h(base)}
  alt={alt ?? p.alt[lang]}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  crossorigin="anonymous"
  style={p.focus ? `object-position:${p.focus}` : undefined}
/>
<style>
  .photo { width: 100%; height: 100%; object-fit: cover; background: linear-gradient(135deg, var(--c-ink-2), var(--c-ink-3) 55%, color-mix(in srgb, var(--c-sun) 35%, var(--c-ink-3))); color: transparent; }
</style>
