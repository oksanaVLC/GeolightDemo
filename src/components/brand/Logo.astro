---
/** Logotipo completo (isotipo + wordmark). Hereda color del texto; el sol usa --c-sun. */
import LogoMark from './LogoMark.astro';
interface Props { size?: 'sm' | 'md' | 'lg'; class?: string }
const { size = 'md', class: className = '' } = Astro.props;
const px = { sm: 24, md: 30, lg: 44 }[size];
---
<span class:list={['logo', `logo--${size}`, className]}>
  <LogoMark size={px} />
  <span class="logo__word">geolight</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55em; color: inherit; }
  .logo__word { font-weight: 600; letter-spacing: -0.045em; font-size: 1.45rem; line-height: 1; }
  .logo--sm .logo__word { font-size: 1.15rem; }
  .logo--lg .logo__word { font-size: 2.1rem; }
</style>
